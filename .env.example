# Ollama (see your deployment) — must be Ollama’s origin (port 11434), not this Next.js app
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=corby:latest

# NextAuth — set AUTH_SECRET in production (generate: openssl rand -base64 32).
# In development, a built-in fallback is used if this is unset; production requires a real secret.
# AUTH_SECRET=
# Public URL of the app in production (e.g. https://corby.ai)
# AUTH_URL=https://your-domain.com
# Optional: enables login?callbackUrl=https://your-domain.com/... on the server (can match AUTH_URL)
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# Comma-separated emails that receive admin role on registration (optional)
# ADMIN_EMAILS=you@example.com,other@example.com

# MySQL — users, question logs, admin dashboard (run: npm run db:migrate)
# Encode special characters in the password (e.g. $ → %24)
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
# Optional: MYSQL_SSL=0 to disable TLS for local MySQL only
