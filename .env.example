# Ollama (see your deployment)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=corby:latest

# Admin dashboard at /admin — required to sign in and view logged questions
ADMIN_PASSWORD=change-me-to-a-long-random-secret

# MySQL — question logs + admin dashboard (run: npm run db:migrate)
# Encode special characters in the password (e.g. $ → %24)
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
# Optional: MYSQL_SSL=0 to disable TLS for local MySQL only
